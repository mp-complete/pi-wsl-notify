{
  "name": "@mp-complete/pi-wsl-notify",
  "version": "0.1.0",
  "description": "Cancellation-aware Windows notifications for Pi in WSL, with short same-provider AI summaries.",
  "type": "module",
  "license": "MIT",
  "author": "Miles Possing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-complete/pi-wsl-notify.git"
  },
  "homepage": "https://github.com/mp-complete/pi-wsl-notify#readme",
  "bugs": {
    "url": "https://github.com/mp-complete/pi-wsl-notify/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "wsl",
    "windows",
    "notifications"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "extensions/wsl-notify.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "pi": {
    "extensions": [
      "./extensions/wsl-notify.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning --test tests/*.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
